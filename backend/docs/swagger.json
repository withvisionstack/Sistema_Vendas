{
    "swagger": "2.0",
    "info": {
        "description": "API de ruas, bairros e administração.",
        "title": "API Mapa Cidade",
        "contact": {
            "name": "Suporte",
            "email": "suporte@exemplo.com"
        },
        "license": {
            "name": "MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/admin/ruas": {
            "get": {
                "description": "Retorna todas as ruas com bairro_fonte=manual.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Lista ruas adicionadas manualmente",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Cadastra nome, bairro, coordenadas e CEP de uma rua nova.\nSalva em data/ruas_extras.json (persistente entre reinícios).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Adiciona uma rua manualmente",
                "parameters": [
                    {
                        "description": "Dados da rua",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.NovaRua"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/bairros": {
            "get": {
                "description": "Retorna bairros com campo \"ruas\" recalculado em tempo real.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "bairros"
                ],
                "summary": "Lista bairros com contagem de ruas",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    }
                }
            }
        },
        "/api/geocode-reverso": {
            "get": {
                "description": "Recebe lat/lon e retorna o bairro mais provável, baseado nas ruas mais próximas.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geocode"
                ],
                "summary": "Geocode reverso (coordenada → bairro)",
                "parameters": [
                    {
                        "type": "number",
                        "format": "float64",
                        "description": "Latitude",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "format": "float64",
                        "description": "Longitude",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "format": "float64",
                        "description": "Raio de busca em metros (default: 2000)",
                        "name": "raio",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/pedidos": {
            "post": {
                "description": "Salva o pedido com localização. Os dados alimentam a base de ruas.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pedidos"
                ],
                "summary": "Cria um pedido (com coleta de dados)",
                "parameters": [
                    {
                        "description": "Dados do pedido",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/backend.Pedido"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/rota": {
            "post": {
                "description": "Chama Valhalla, retorna polyline + instruções + ETA",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "navegacao"
                ],
                "summary": "Calcula rota",
                "parameters": [
                    {
                        "description": "Origem e destino",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.RotaRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/ruas": {
            "get": {
                "description": "Busca ruas por nome (normalizado, sem acento).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ruas"
                ],
                "summary": "Busca ruas",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Termo de busca",
                        "name": "busca",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/saude": {
            "get": {
                "description": "Retorna status, contagem de ruas e bairros.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sistema"
                ],
                "summary": "Saúde da API",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "backend.Pedido": {
            "type": "object",
            "required": [
                "bairro",
                "rua"
            ],
            "properties": {
                "accuracy_m": {
                    "type": "number"
                },
                "bairro": {
                    "type": "string"
                },
                "bairro_detectado": {
                    "description": "resultado do geocode",
                    "type": "string"
                },
                "cliente_nome": {
                    "type": "string"
                },
                "complemento": {
                    "type": "string"
                },
                "confianca_geo": {
                    "type": "number"
                },
                "criado_em": {
                    "type": "string"
                },
                "fonte_coord": {
                    "description": "\"gps\", \"pin_mapa\", \"manual\"",
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "itens": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.Item"
                    }
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "numero": {
                    "type": "string"
                },
                "referencia": {
                    "type": "string"
                },
                "rua": {
                    "type": "string"
                },
                "telefone": {
                    "type": "string"
                },
                "total_centavos": {
                    "type": "integer"
                }
            }
        },
        "main.Item": {
            "type": "object",
            "properties": {
                "nome": {
                    "type": "string"
                },
                "preco_centavos": {
                    "type": "integer"
                },
                "qtd": {
                    "type": "integer"
                }
            }
        },
        "main.NovaRua": {
            "type": "object",
            "required": [
                "lat",
                "lon",
                "nome"
            ],
            "properties": {
                "bairro": {
                    "type": "string"
                },
                "cep": {
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "nome": {
                    "type": "string"
                }
            }
        },
        "main.RotaRequest": {
            "type": "object",
            "required": [
                "destino_lat",
                "destino_lon",
                "origem_lat",
                "origem_lon"
            ],
            "properties": {
                "destino_lat": {
                    "type": "number"
                },
                "destino_lon": {
                    "type": "number"
                },
                "origem_lat": {
                    "type": "number"
                },
                "origem_lon": {
                    "type": "number"
                }
            }
        }
    }
}